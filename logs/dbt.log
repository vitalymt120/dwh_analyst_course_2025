  create  table "dwh_db"."analytics_mart"."mart_top_suppliers__dbt_tmp"
  
  
    as
  
  (
    select 
    s.supplier_name,
    count(f.sale_id) as total_sales,
    sum(f.sale_amount) as total_revenue,
    sum(f.profit) as total_profit,
    avg(f.margin_percent) as avg_margin_percent
from "dwh_db"."analytics_dds"."facts_sales" f
join "dwh_db"."analytics_dds"."dim_suppliers" s on f.supplier_id = s.supplier_id
group by s.supplier_id, s.supplier_name
order by total_revenue desc
  );
  
