  create  table "dwh_db"."analytics"."mart_top_suppliers__dbt_tmp"
  
  
    as
  
  (
    select 
    s.supplier_id,
    s.supplier_name,
    s.region,
    s.rating,
    sum(f.total_amount) as total_revenue,
    sum(f.profit) as total_profit,
    count(*) as total_orders
from "dwh_db"."analytics"."facts_sales" f
join "dwh_db"."analytics"."dim_suppliers" s 
    on f.supplier_id = s.supplier_id
group by 
    s.supplier_id,
    s.supplier_name,
    s.region,
    s.rating
order by total_revenue desc
  );
  
